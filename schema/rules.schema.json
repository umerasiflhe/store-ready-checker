{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/umerasiflhe/store-ready-checker/schema/rules.schema.json",
  "title": "Store Ready rules data",
  "type": "object",
  "required": ["rulesVersion", "rules"],
  "additionalProperties": false,
  "properties": {
    "rulesVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$" },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "platform", "title", "timeline", "sources", "fix"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z]+-[A-Z0-9]+-\\d{3}$" },
        "platform": { "enum": ["ios", "android"] },
        "title": { "type": "string" },
        "confidence": { "enum": ["certain", "heuristic"] },
        "appliesWhen": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "targetSdkAtLeast": { "type": "integer" },
            "abis": { "type": "array", "items": { "type": "string" } },
            "inputKind": { "enum": ["ipa", "aab", "apk"] },
            "formFactors": {
              "type": "array",
              "items": { "enum": ["phone_tablet", "wear", "tv", "automotive", "xr"] }
            }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        },
        "timeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["from", "severity"],
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "format": "date" },
              "severity": { "enum": ["error", "warning", "info"] },
              "note": { "type": "string" }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url", "retrieved"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "retrieved": { "type": "string", "format": "date" }
            }
          }
        },
        "fix": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
