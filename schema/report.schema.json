{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/umerasiflhe/store-ready-checker/schema/report.schema.json",
  "title": "Store Ready report",
  "type": "object",
  "required": ["tool", "asOf", "input", "app", "summary", "findings"],
  "additionalProperties": false,
  "properties": {
    "tool": {
      "type": "object",
      "required": ["name", "version", "rulesVersion"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "rulesVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$" }
      }
    },
    "asOf": { "type": "string", "format": "date" },
    "input": {
      "type": "object",
      "required": ["fileName", "sizeBytes", "kind"],
      "additionalProperties": false,
      "properties": {
        "fileName": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["ipa", "aab", "apk"] }
      }
    },
    "app": {
      "type": "object",
      "required": ["platform", "id", "version", "build"],
      "additionalProperties": false,
      "properties": {
        "platform": { "enum": ["ios", "android"] },
        "id": { "type": "string" },
        "version": { "type": "string" },
        "build": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["status", "errors", "warnings", "infos"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["blocked", "attention", "ready"] },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "infos": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "ruleId",
        "severity",
        "confidence",
        "title",
        "message",
        "evidence",
        "fix",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "ruleId": { "type": "string" },
        "severity": { "enum": ["error", "warning", "info"] },
        "confidence": { "enum": ["certain", "heuristic"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "evidence": { "type": "object" },
        "fix": { "type": "array", "items": { "type": "string" } },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    }
  }
}
