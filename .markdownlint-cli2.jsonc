{
  "config": {
    "default": true,
    "MD013": false,
    // Keep a Changelog repeats "### Added"/"### Fixed" under every version; still flag
    // duplicates among siblings (within one version).
    "MD024": { "siblings_only": true },
  },
  "globs": ["**/*.md"],
  "ignores": [
    "docs/BUILD_BRIEF.md",
    "node_modules/**",
    "**/.build/**",
    "coverage/**",
    "playwright-report/**",
    "test-results/**",
    "dist/**",
    "fixtures/files/**",
  ],
}
