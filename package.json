{
  "name": "store-ready",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/core",
    "apps/web"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings 0 && npm run lint:swift && npx markdownlint-cli2 && npm run lint:actions && npm run lint:shell",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:swift": "bash -c '[ ! -d cli ] || ! command -v swift >/dev/null 2>&1 || (cd cli && (swift format lint --strict --recursive Sources Tests Package.swift 2>/dev/null || xcrun swift-format lint --strict --recursive Sources Tests Package.swift))'",
    "lint:actions": "bash -c '[ ! -d .github/workflows ] || actionlint'",
    "lint:shell": "bash -c 'shopt -s nullglob; files=(scripts/*.sh .claude/hooks/*.sh); [ ${#files[@]} -eq 0 ] || shellcheck \"${files[@]}\"'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:swift": "swift test --package-path cli",
    "check:repo": "tsx scripts/check-repo.ts",
    "proto:gen": "tsx scripts/gen-proto.ts",
    "rules:sync": "tsx scripts/sync-rules.ts",
    "rules:doc": "tsx scripts/gen-rules-doc.ts",
    "gen:web-samples": "tsx scripts/gen-web-samples.ts",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "size": "size-limit",
    "verify": "./scripts/verify.sh",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/eslint-plugin": "^1.6.27",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "fast-check": "^4.10.2",
    "lefthook": "^2.2.2",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "size-limit": [
    {
      "name": "initial JS (gzip)",
      "path": "apps/web/dist/assets/index-*.js",
      "limit": "120 KB",
      "gzip": true
    }
  ]
}
